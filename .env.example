# Copy to .env for local-only configuration. Never commit .env.
POSTGRES_DB=mobilend
POSTGRES_USER=mobilend
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Django configuration (used after the project scaffold is created)
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
